# qbank 环境变量示例。复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，切勿提交。
# 也可以不建 .env，直接在系统环境变量里设置，二者等价（真实环境变量优先级更高）。

# 阿里云百炼 DashScope（主力 provider）
# 申请入口：https://bailian.console.aliyun.com/ -> API-KEY 管理
# 缺失时服务不会崩溃，只会把 bailian 从 fallback 链里剔除并打印一条提示。
DASHSCOPE_API_KEY=

# OpenAI（可选，默认不在 fallback 链上；要用请改 config.json 的 ai.fallback）
OPENAI_API_KEY=

# Ollama 本地模型（备用 provider，免审核、免网络）无需 Key，
# 只需本地已运行：ollama serve && ollama pull qwen2.5:7b
# 如需改地址可设置下面这一项：
# OLLAMA_BASE_URL=http://127.0.0.1:11434
